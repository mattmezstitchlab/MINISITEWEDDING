# Variables d’environnement
#
# Le projet fonctionne SANS aucune de ces variables : les sites vivent alors
# dans le navigateur et se publient par fichier (`public/sites/<slug>.json`).
# Copiez ce fichier en `.env` (`cp .env.example .env`) seulement si vous
# branchez une base distante ou un point de collecte des réponses.
#
# Préfixes exposés au navigateur : `VITE_` et `NEXT_PUBLIC_` (voir vite.config.ts).
# Tout ce qui est serveur doit rester sans préfixe. Aucun secret ne se commit.

# --- Source des données -------------------------------------------------------
# Vide = mode autonome (base du navigateur, aucun service externe).
# `local` force le mode autonome même si une base est déclarée ; `api` force
# l’appel aux fonctions de `api/`.
VITE_DATA_SOURCE=

# --- Réponses des invités (facultatif) ----------------------------------------
# En mode autonome, chaque réponse part directement aux mariés (WhatsApp ou
# e-mail, message déjà rédigé). Pour les rassembler au même endroit, indiquez
# l’URL d’un formulaire gratuit (Formspree, Web3Forms…) : chaque réponse y est
# déposée en plus.
VITE_RSVP_WEBHOOK=

# --- Base distante (facultatif) -----------------------------------------------
# Renseignez ces variables pour repasser sur Supabase : les écrans sont
# inchangés, l’aiguillage se fait dans `src/lib/dataSource.ts`. Sans elles,
# aucune requête ne part vers un service externe.
FULLSTACK_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Clé de service : contourne RLS. À ne JAMAIS exposer côté client ni committer.
SUPABASE_SERVICE_ROLE_KEY=

# Réveil de la base (`server/db-wake.js`) : appelés quand une requête renvoie
# un 5xx, pour sortir un projet en veille.
FULLSTACK_RESTORE_API_URL=

# --- Copies publiées ----------------------------------------------------------
# À `1`, les mini-sites sont servis directement depuis `public/sites/<slug>.json`
# sans passer par l’API.
VITE_STATIC_SITES=
