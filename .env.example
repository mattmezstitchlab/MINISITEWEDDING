# Variables d’environnement
#
# Ce fichier est un modèle : copiez-le en `.env` pour le développement local
# (`cp .env.example .env`) et saisissez les mêmes valeurs dans le dashboard de
# votre hébergeur pour la production. Aucun secret ne doit être commité.
#
# Préfixes exposés au navigateur : VITE_ et NEXT_PUBLIC_ (voir vite.config.ts).
# Tout ce qui est serveur (SUPABASE_SERVICE_ROLE_KEY) doit rester sans préfixe.

# --- Supabase ----------------------------------------------------------------
# Projet Supabase qui porte les tables du schéma (voir supabase/schema.sql).
FULLSTACK_PROJECT_REF=

# Clé publique : utilisable depuis le navigateur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Clé de service : contourne RLS. À ne JAMAIS exposer côté client ni committer.
SUPABASE_SERVICE_ROLE_KEY=

# --- Copies statiques (repli quand Supabase ne répond pas) ---------------------
# À `1`, les mini-sites sont servis depuis public/sites/<slug>.json sans passer
# par l’API : utile le temps qu’un projet Supabase en pause soit rétabli.
# Sans cette variable, l’API prime et les copies ne servent qu’en cas d’échec.
VITE_STATIC_SITES=

# --- Réveil de la base (api/db-wake.js) ---------------------------------------
# Appelés quand une requête renvoie un 5xx, pour sortir le projet de veille.
FULLSTACK_RESTORE_API_URL=

# --- Partage (optionnel) ------------------------------------------------------
# Utilisés par le panneau « Partager » si vous branchez un OAuth Google.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_PROXY=
